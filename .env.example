# Configurações do Servidor
PORT=3000

# String de Conexão com o PostgreSQL
# Formato: postgres://<usuario>:<senha>@<host>:<porta>/<banco_de_dados>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/movixfrota

# Configurações Opcionais para Supabase Storage (Upload de imagens em nuvem persistente)
# Se preenchido, os uploads salvam no Supabase Storage. Se omitido/vazio, salva localmente na pasta /public/uploads.
# SUPABASE_URL=https://<project_id>.supabase.co
# SUPABASE_KEY=<sua_anon_public_key_aqui>
